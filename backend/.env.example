# Servidor HTTP
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Supabase.
# DATABASE_URL: conexão de execução. Em IPv4, use o Session pooler (porta 5432)
# para um backend persistente ou o Transaction pooler (porta 6543) em serverless.
# DIRECT_URL: conexão direta (porta 5432) usada pelas migrations. Se a rede não
# possuir IPv6, o Session pooler pode ser usado como alternativa.
DATABASE_URL=
DIRECT_URL=

# Obrigatórias antes de habilitar autenticação e emissão de ingressos.
JWT_SECRET=
JWT_EXPIRES_IN=7d
TICKET_SIGNING_SECRET=

# Integração externa usada na pesquisa e importação de eventos.
TICKETMASTER_API_KEY=

# Habilite somente em ambiente local ou de demonstração para executar o seed.
DEMO_SEED_ENABLED=false
gitdasdsadas