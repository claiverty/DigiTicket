# Servidor HTTP
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Supabase. Use a conexão com pool em DATABASE_URL e a conexão
# direta nas migrations do Prisma quando o projeto Supabase disponibilizar uma.
DATABASE_URL=
DIRECT_URL=

# Obrigatórias antes de habilitar autenticação e emissão de ingressos.
JWT_SECRET=
JWT_EXPIRES_IN=7d
TICKET_SIGNING_SECRET=

# Integração externa opcional, utilizada somente em uma fase futura.
TICKETMASTER_API_KEY=
