generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ORGANIZER
  CUSTOMER
  GATE
}

enum EventCategory {
  SHOW
  MOVIE
  THEATER
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventSaleMode {
  GENERAL_ADMISSION
  RESERVED_SEATING
}

enum ReservationStatus {
  PENDING_PAYMENT
  PAID
  DECLINED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  APPROVED
  DECLINED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  events        Event[]
  reservations  Reservation[]
  tickets       Ticket[]

  @@map("users")
}

model Event {
  id             String        @id @default(uuid()) @db.Uuid
  organizerId    String        @map("organizer_id") @db.Uuid
  title          String
  slug           String        @unique
  description    String        @db.Text
  category       EventCategory
  saleMode       EventSaleMode @map("sale_mode")
  venueName      String        @map("venue_name")
  address        String
  city           String
  state          String        @db.Char(2)
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  posterUrl      String?       @map("poster_url")
  status         EventStatus   @default(DRAFT)
  externalSource String?       @map("external_source")
  externalId     String?       @map("external_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organizer      User          @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes    TicketType[]
  reservations   Reservation[]
  tickets        Ticket[]

  @@unique([externalSource, externalId])
  @@index([organizerId, status])
  @@index([status, startDate])
  @@index([category, city])
  @@map("events")
}

model TicketType {
  id                String            @id @default(uuid()) @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  name              String
  description       String?           @db.Text
  priceCents        Int               @map("price_cents")
  capacity          Int
  availableQuantity Int               @map("available_quantity")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservationItems  ReservationItem[]
  tickets           Ticket[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("ticket_types")
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  eventId    String            @map("event_id") @db.Uuid
  status     ReservationStatus @default(PENDING_PAYMENT)
  totalCents Int               @map("total_cents")
  expiresAt  DateTime          @map("expires_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  customer   User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items      ReservationItem[]
  payment    Payment?
  tickets    Ticket[]

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@index([eventId, status])
  @@map("reservations")
}

model ReservationItem {
  id             String      @id @default(uuid()) @db.Uuid
  reservationId  String      @map("reservation_id") @db.Uuid
  ticketTypeId   String      @map("ticket_type_id") @db.Uuid
  quantity       Int
  unitPriceCents Int         @map("unit_price_cents")
  createdAt      DateTime    @default(now()) @map("created_at")
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketType     TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets        Ticket[]

  @@unique([reservationId, ticketTypeId])
  @@index([ticketTypeId])
  @@map("reservation_items")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @unique @map("reservation_id") @db.Uuid
  status        PaymentStatus
  amountCents   Int           @map("amount_cents")
  processedAt   DateTime      @default(now()) @map("processed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([status, processedAt])
  @@map("payments")
}

model Ticket {
  id                String          @id @default(uuid()) @db.Uuid
  eventId           String          @map("event_id") @db.Uuid
  customerId        String          @map("customer_id") @db.Uuid
  reservationId     String          @map("reservation_id") @db.Uuid
  reservationItemId String          @map("reservation_item_id") @db.Uuid
  ticketTypeId      String          @map("ticket_type_id") @db.Uuid
  status            TicketStatus    @default(ACTIVE)
  usedAt            DateTime?       @map("used_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  event              Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  customer           User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reservation        Reservation     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  reservationItem    ReservationItem @relation(fields: [reservationItemId], references: [id], onDelete: Restrict)
  ticketType          TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([eventId, status])
  @@index([reservationId])
  @@map("tickets")
}
