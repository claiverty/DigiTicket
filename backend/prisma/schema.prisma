generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Os modelos de domínio serão adicionados junto dos respectivos módulos.
// Por enquanto, o schema válido permite preparar a conexão com PostgreSQL/Supabase
// antes da inclusão das entidades de autenticação e eventos.
