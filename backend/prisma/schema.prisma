generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ORGANIZER
  CUSTOMER
  GATE
}

enum EventCategory {
  SHOW
  MOVIE
  THEATER
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventSaleMode {
  GENERAL_ADMISSION
  RESERVED_SEATING
}

enum ReservationStatus {
  PENDING_PAYMENT
  PAID
  DECLINED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  APPROVED
  DECLINED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum TicketValidationResult {
  VALID
  INVALID
  WRONG_EVENT
  ALREADY_USED
}

enum TicketValidationMethod {
  QR
  MANUAL
}

enum TicketTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
  DECLINED
}

enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

enum SeatDisplaySize {
  STANDARD
  LARGE
}

model User {
  id                      String                @id @default(uuid()) @db.Uuid
  name                    String
  email                   String                @unique
  passwordHash            String                @map("password_hash")
  role                    Role                  @default(CUSTOMER)
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  events                  Event[]
  reservations            Reservation[]
  tickets                 Ticket[]
  gateValidations         TicketValidationLog[] @relation("GateUserValidations")
  sentTicketTransfers     TicketTransfer[]      @relation("TicketTransferSender")
  receivedTicketTransfers TicketTransfer[]      @relation("TicketTransferRecipient")

  @@map("users")
}

model Event {
  id             String                @id @default(uuid()) @db.Uuid
  organizerId    String                @map("organizer_id") @db.Uuid
  title          String
  slug           String                @unique
  description    String                @db.Text
  category       EventCategory
  saleMode       EventSaleMode         @map("sale_mode")
  venueName      String                @map("venue_name")
  address        String
  city           String
  state          String                @db.Char(2)
  startDate      DateTime              @map("start_date")
  endDate        DateTime              @map("end_date")
  posterUrl      String?               @map("poster_url")
  status         EventStatus           @default(DRAFT)
  externalSource String?               @map("external_source")
  externalId     String?               @map("external_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  organizer      User                  @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes    TicketType[]
  reservations   Reservation[]
  tickets        Ticket[]
  validationLogs TicketValidationLog[]
  seats          EventSeat[]

  @@unique([externalSource, externalId])
  @@index([organizerId, status])
  @@index([status, startDate])
  @@index([category, city])
  @@map("events")
}

model TicketType {
  id                String            @id @default(uuid()) @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  name              String
  description       String?           @db.Text
  priceCents        Int               @map("price_cents")
  capacity          Int
  availableQuantity Int               @map("available_quantity")
  seatDisplaySize   SeatDisplaySize   @default(STANDARD) @map("seat_display_size")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservationItems  ReservationItem[]
  tickets           Ticket[]
  seats             EventSeat[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("ticket_types")
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  eventId    String            @map("event_id") @db.Uuid
  status     ReservationStatus @default(PENDING_PAYMENT)
  totalCents Int               @map("total_cents")
  expiresAt  DateTime          @map("expires_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  customer   User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items      ReservationItem[]
  payment    Payment?
  tickets    Ticket[]
  heldSeats  EventSeat[]

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@index([eventId, status])
  @@map("reservations")
}

model ReservationItem {
  id             String      @id @default(uuid()) @db.Uuid
  reservationId  String      @map("reservation_id") @db.Uuid
  ticketTypeId   String      @map("ticket_type_id") @db.Uuid
  quantity       Int
  unitPriceCents Int         @map("unit_price_cents")
  createdAt      DateTime    @default(now()) @map("created_at")
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketType     TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets        Ticket[]

  @@unique([reservationId, ticketTypeId])
  @@index([ticketTypeId])
  @@map("reservation_items")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @unique @map("reservation_id") @db.Uuid
  status        PaymentStatus
  amountCents   Int           @map("amount_cents")
  processedAt   DateTime      @default(now()) @map("processed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([status, processedAt])
  @@map("payments")
}

model Ticket {
  id                String                @id @default(uuid()) @db.Uuid
  eventId           String                @map("event_id") @db.Uuid
  customerId        String                @map("customer_id") @db.Uuid
  reservationId     String                @map("reservation_id") @db.Uuid
  reservationItemId String                @map("reservation_item_id") @db.Uuid
  ticketTypeId      String                @map("ticket_type_id") @db.Uuid
  ticketCode        String                @unique @map("ticket_code")
  manualCode        String                @unique @map("manual_code")
  shareToken        String?               @unique @map("share_token")
  sharedAt          DateTime?             @map("shared_at")
  status            TicketStatus          @default(ACTIVE)
  usedAt            DateTime?             @map("used_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  event             Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  customer          User                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reservation       Reservation           @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  reservationItem   ReservationItem       @relation(fields: [reservationItemId], references: [id], onDelete: Restrict)
  ticketType        TicketType            @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  seatId            String?               @unique @map("seat_id") @db.Uuid
  seat              EventSeat?            @relation(fields: [seatId], references: [id], onDelete: Restrict)
  validationLogs    TicketValidationLog[]
  transfers         TicketTransfer[]

  @@index([customerId, createdAt])
  @@index([eventId, status])
  @@index([reservationId])
  @@map("tickets")
}

model EventSeat {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  ticketTypeId  String       @map("ticket_type_id") @db.Uuid
  reservationId String?      @map("reservation_id") @db.Uuid
  rowLabel      String       @map("row_label")
  seatNumber    Int          @map("seat_number")
  status        SeatStatus   @default(AVAILABLE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  ticket        Ticket?

  @@unique([eventId, rowLabel, seatNumber])
  @@index([eventId, status])
  @@index([ticketTypeId])
  @@index([reservationId])
  @@map("event_seats")
}

model TicketValidationLog {
  id                String                 @id @default(uuid()) @db.Uuid
  ticketId          String?                @map("ticket_id") @db.Uuid
  eventId           String                 @map("event_id") @db.Uuid
  gateUserId        String                 @map("gate_user_id") @db.Uuid
  result            TicketValidationResult
  method            TicketValidationMethod
  presentedCodeHash String                 @map("presented_code_hash")
  createdAt         DateTime               @default(now()) @map("created_at")
  ticket            Ticket?                @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  gateUser          User                   @relation("GateUserValidations", fields: [gateUserId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([ticketId, createdAt])
  @@index([gateUserId, createdAt])
  @@map("ticket_validation_logs")
}

model TicketTransfer {
  id          String               @id @default(uuid()) @db.Uuid
  ticketId    String               @map("ticket_id") @db.Uuid
  senderId    String               @map("sender_id") @db.Uuid
  recipientId String               @map("recipient_id") @db.Uuid
  status      TicketTransferStatus @default(PENDING)
  resolvedAt  DateTime?            @map("resolved_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  ticket      Ticket               @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  sender      User                 @relation("TicketTransferSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient   User                 @relation("TicketTransferRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([senderId, createdAt])
  @@index([recipientId, status, createdAt])
  @@index([ticketId, createdAt])
  @@map("ticket_transfers")
}
